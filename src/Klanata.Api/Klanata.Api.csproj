<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klanata.Application\Klanata.Application.csproj" />
    <ProjectReference Include="..\Klanata.Infrastructure\Klanata.Infrastructure.csproj" />
    <ProjectReference Include="..\Klanata.Workers\Klanata.Workers.csproj" />
  </ItemGroup>

  <Target Name="BuildReactClient" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="..\Klanata.Web" Command="npm ci" />
    <Exec WorkingDirectory="..\Klanata.Web" Command="npm run build" />
  </Target>

</Project>
